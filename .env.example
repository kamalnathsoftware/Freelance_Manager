# ---- Core ----
ENVIRONMENT=development
DATABASE_URL=postgresql+asyncpg://fm:fm@postgres:5432/fm
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-to-a-long-random-string          # JWT signing
ENCRYPTION_KEY=                                       # Fernet key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
CORS_ORIGINS=["http://localhost:3000"]
WEB_BASE_URL=http://localhost:3000

# ---- Production (docker-compose.prod.yml) ----
APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
POSTGRES_PASSWORD=change-me
PUBLIC_API_URL=http://localhost:8000                   # externally reachable API URL (chat widget snippet, calendar feed URL)
UPLOAD_DIR=./uploads                                   # file storage (mount a volume; swap services/storage.py for S3/R2)
MAX_UPLOAD_MB=5
ADMIN_EMAILS=[]                                        # JSON list of emails allowed to open /ops, e.g. ["you@example.com"]
AI_MODEL=claude-sonnet-5-5                             # model used for rewrites/drafts/assistant

# ---- Email (SMTP; mailhog in docker-compose) ----
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=no-reply@freelancemanager.local

# ---- Google (login + Gmail ingestion + Calendar) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- AI (rewrite / proposals / replies) ----
ANTHROPIC_API_KEY=

# ---- Notifications (phase 5) ----
FCM_SERVER_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=                                # any string; must match the webhook config in Meta
WHATSAPP_APP_SECRET=                                   # Meta app secret: webhook signatures are verified with it
WHATSAPP_TEMPLATE=fm_notification                      # approved template with 3 body params (title, body, reply code)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=                               # set via setWebhook secret_token
TWILIO_FROM=
EXPO_ACCESS_TOKEN=
VAPID_PUBLIC_KEY=                                      # web push: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=

# ---- Platform APIs (phase 2/3) ----
UPWORK_CLIENT_ID=
UPWORK_CLIENT_SECRET=
FREELANCER_CLIENT_ID=
FREELANCER_CLIENT_SECRET=

# ---- Ops ----
SENTRY_DSN=
NEXT_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
